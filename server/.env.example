# Copy to .env (server/.env for local dev). Never commit .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public origin, used for links in emails and OAuth redirects
APP_URL=http://localhost:3000
# Set to true behind Caddy/HTTPS so cookies get the Secure flag
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=olchar
DB_PASSWORD=olchar
DB_NAME=olchar

# 32+ random bytes, base64. Used to sign/HMAC tokens.
SECRET_KEY=change-me

# Email (Resend). If RESEND_API_KEY is empty, mails are logged to stdout instead.
RESEND_API_KEY=
MAIL_FROM=noreply@ol-character.de

# Discord OAuth (optional; login button hidden if empty)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# First admin: created (or promoted) on startup if set
ADMIN_EMAIL=

# --- In-app bug reports / feature requests -> GitHub issues (optional) ------
# Fine-grained personal access token with "Issues: Read and write" on the repo.
# Create at https://github.com/settings/personal-access-tokens . Form is hidden when empty.
GITHUB_ISSUES_TOKEN=
GITHUB_REPO=Tenshinzo/OL-CharacterSheet
