{
  "name": "ol-character-server",
  "version": "1.0.0",
  "description": "Backend for the Open Legend Character Sheet (accounts, persistence, live sync, groups)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "test": "node --test --test-concurrency=1 'test/*.test.js'",
    "lint": "eslint .",
    "admin:promote": "node src/cli.js promote",
    "admin:invite": "node src/cli.js invite",
    "admin:reset-password": "node src/cli.js reset-password"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "ws": "^8.22.0"
  }
}
