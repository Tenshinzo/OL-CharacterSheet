# Production environment for docker-compose.prod.yml.
# Copy to /opt/olchar/app/.env and fill in every value marked CHANGE-ME.
# This file is read by `env_file` for the app container and by variable
# substitution for the db container. Never commit the real .env.
#
# TEST INSTANCE (/opt/olchar-test/app, see DEPLOY.md section 9): same file, but
#   COMPOSE_PROJECT_NAME=olchar-test     (separate containers, network and db volume)
#   PROXY_ALIAS=olchar-test-app          (upstream name used in deploy/Caddyfile)
#   APP_IMAGE=olchar-test-app
#   APP_URL=https://test.ol-character.de
#   own SECRET_KEY and DB passwords; GITHUB_ISSUES_TOKEN empty (no issues from test data);
#   DISCORD_* either empty or a separate Discord application with the test callback URL.
# Production must NOT set COMPOSE_PROJECT_NAME: its project is "app" (volumes app_*).

# --- Compose (instance identity; leave at defaults for production) ----------
#COMPOSE_PROJECT_NAME=olchar-test
#PROXY_ALIAS=olchar-test-app
#APP_IMAGE=olchar-test-app

# --- App -------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Public origin; used for e-mail links, OAuth redirects and the CSRF origin check.
APP_URL=https://ol-character.de
# Caddy terminates TLS and forwards X-Forwarded-*; required for Secure cookies.
TRUST_PROXY=true

# --- Database (as seen from the app container) -------------------------------
DB_HOST=db
DB_PORT=3306
DB_USER=olchar
DB_NAME=olchar
# Must equal MYSQL_PASSWORD below. Generate: openssl rand -base64 32
DB_PASSWORD=CHANGE-ME

# --- Database container (mysql:8.4) ----------------------------------------
# These mirror DB_*; the db container creates the database and user on first start.
MYSQL_DATABASE=olchar
MYSQL_USER=olchar
MYSQL_PASSWORD=CHANGE-ME
# Root password is only used inside the db container (healthcheck, backups). Generate: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=CHANGE-ME

# --- Secrets ---------------------------------------------------------------
# Signs sessions and e-mail tokens. 32+ random bytes, base64. Generate with:
#   openssl rand -base64 48
# Changing it invalidates all sessions and pending e-mail tokens.
SECRET_KEY=CHANGE-ME

# --- E-mail (Resend) -------------------------------------------------------
# From https://resend.com/api-keys. If empty, mails are only logged to stdout.
RESEND_API_KEY=CHANGE-ME
# Must be on a domain verified in Resend.
MAIL_FROM=noreply@ol-character.de

# --- Discord OAuth (optional; login button hidden when empty) ---------------
# Redirect URL to register in the Discord developer portal:
#   https://ol-character.de/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- First admin -----------------------------------------------------------
# On startup this account is created (passwordless, pre-verified) or promoted to admin.
# Set its password afterwards via the forgot-password flow or
#   docker compose -f docker-compose.prod.yml exec app node src/cli.js reset-password <email> <password>
ADMIN_EMAIL=CHANGE-ME@example.com

# --- In-app bug reports / feature requests -> GitHub issues (optional) ------
# Fine-grained personal access token with "Issues: Read and write" on the repo.
# Create at https://github.com/settings/personal-access-tokens . Form is hidden when empty.
GITHUB_ISSUES_TOKEN=
GITHUB_REPO=Tenshinzo/OL-CharacterSheet
