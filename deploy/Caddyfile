# Caddy config for ol-character.de and test.ol-character.de. Mounted read-only into the
# caddy container by deploy/docker-compose.proxy.yml. Caddy obtains and renews Let's Encrypt
# certificates automatically (DNS for all names must point at this server).
#
# Upstreams are the aliases the app stacks register on the shared `olchar-proxy` network
# (PROXY_ALIAS in each instance's .env). Kept hardcoded on purpose.

{
    email admin@ol-character.de
}

(common) {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        -Server
    }
}

www.ol-character.de {
    redir https://ol-character.de{uri} 301
}

# Production: /opt/olchar/app
ol-character.de {
    import common
    # WebSockets (/api/ws) are proxied transparently; no extra config needed.
    reverse_proxy olchar-app:3000
}

# Test system: /opt/olchar-test/app, deployed manually from any branch (Actions -> Deploy).
test.ol-character.de {
    import common
    header X-Robots-Tag "noindex, nofollow"
    reverse_proxy olchar-test-app:3000
}
